# Copiez ce fichier en ".env" pour travailler sur votre ordinateur.
# En ligne (Render, Railway...), ajoutez ces variables dans le tableau de bord de l'hébergeur.

# Nom affiché de votre SaaS
APP_NAME=WariBook

# Phrase secrète longue et aléatoire (OBLIGATOIRE en production)
SESSION_SECRET=remplacez-moi-par-une-longue-phrase-aleatoire

# Adresse publique de votre site (sans / à la fin), ex : https://waribook.onrender.com
BASE_URL=

# Indicatif pays par défaut pour les liens WhatsApp (225 = Côte d'Ivoire, 221 = Sénégal, 237 = Cameroun...)
DEFAULT_COUNTRY_CODE=225

# Emplacement du fichier de base de données (laisser vide en local)
DATABASE_PATH=

# Paiements des abonnements via CinetPay (laisser vide = mode démo, sans vrai paiement)
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_CURRENCY=XOF
